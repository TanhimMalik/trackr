# Copy to .env.local and fill in values. Never commit real secrets.

# Public origin of the web app (used for auth redirects and the browser extension).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project (Project Settings → API). The publishable key is safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Postgres connection string (Supabase: Project Settings → Database → Connection string).
# Locally, use the session pooler (port 5432). On serverless hosting, use the
# transaction pooler (port 6543); the app disables prepared statements for it.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# Gmail (optional). Without these, Integrations shows Gmail as not set up.
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: <NEXT_PUBLIC_APP_URL>/api/integrations/gmail/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Encrypts stored OAuth tokens: 32 random bytes, base64. Generate with `openssl rand -base64 32`.
# Changing it makes stored tokens unreadable, so connected accounts must reconnect.
TOKEN_ENCRYPTION_KEY=generate-with-openssl-rand-base64-32
